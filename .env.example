# Copy to .env (gitignored) for scripts/bootstrap.mjs ONLY.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses every row-level security policy that
# supabase/tests/rls.test.sql verifies. It must never reach the browser
# bundle, a commit, or a chat window. If it leaks, rotate it immediately:
# Supabase -> Settings -> API -> service_role -> regenerate.
#
# The app itself never uses this file; it uses app/.env.local with the
# anon key, which is public and safe.

SUPABASE_URL=https://cinjcssbtfsirbyqwxsh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
